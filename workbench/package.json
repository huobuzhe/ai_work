{
  "name": "dsh-workbench",
  "version": "1.0.0",
  "private": true,
  "description": "表格工作台：把建表与日常繁琐表格操作收进「一句话 + 10 个一键动作」，改前逐格预览、确认才落盘（本地 Excel 零凭据闭环）。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "workbench",
    "excel",
    "xlsx",
    "spreadsheet",
    "表格",
    "自动化",
    "local-first"
  ],
  "author": "huobuzhe",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huobuzhe/ai_work.git",
    "directory": "workbench"
  },
  "bugs": {
    "url": "https://github.com/huobuzhe/ai_work/issues"
  },
  "homepage": "https://github.com/huobuzhe/ai_work/tree/master/workbench#readme",
  "type": "commonjs",
  "main": "lib/index.mjs",
  "exports": {
    ".": {
      "default": "./lib/index.mjs"
    },
    "./engine": "./lib/engine.js",
    "./host": "./lib/index.mjs",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "scripts",
    "test",
    "registry",
    "templates",
    "preview",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "SMOKE.md",
    "capability-matrix.md"
  ],
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "test": "node --test test/*.test.js",
    "test:engine": "node --test test/engine.test.js",
    "test:smoke": "node --test test/panel-smoke.test.js",
    "test:e2e": "node --test test/e2e-xlsx.test.js",
    "test:formula": "node --test test/formula.test.js test/e2e-formula.test.js",
    "test:templates": "node --test test/templates.test.js test/e2e-templates.test.js",
    "acceptance": "node scripts/acceptance-run.js",
    "acceptance:formula": "node scripts/acceptance-formula.js",
    "test:capability": "node --test test/capability-matrix.test.js",
    "capability:probe": "node scripts/capability-probe.js --run-local --write-matrix",
    "build:preview": "node scripts/build-preview.js",
    "selfcheck": "node scripts/selfcheck.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
