{
  "name": "dsh-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "表格工作台：把建表与日常繁琐表格操作收进按钮与输入框（第一刀=本地 Excel 零凭据闭环）。规格 #8 / 票 #9。",
  "type": "commonjs",
  "main": "lib/index.mjs",
  "exports": {
    ".": {
      "default": "./lib/index.mjs"
    },
    "./engine": "./lib/engine.js",
    "./host": "./lib/index.mjs",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "scripts",
    "test",
    "registry",
    "templates",
    "preview",
    "cordis.patch.yml",
    "README.md",
    "SMOKE.md",
    "capability-matrix.md"
  ],
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "test": "node --test test/*.test.js",
    "test:engine": "node --test test/engine.test.js",
    "test:smoke": "node --test test/panel-smoke.test.js",
    "test:e2e": "node --test test/e2e-xlsx.test.js",
    "test:formula": "node --test test/formula.test.js test/e2e-formula.test.js",
    "test:templates": "node --test test/templates.test.js test/e2e-templates.test.js",
    "acceptance": "node scripts/acceptance-run.js",
    "acceptance:formula": "node scripts/acceptance-formula.js",
    "test:capability": "node --test test/capability-matrix.test.js",
    "capability:probe": "node scripts/capability-probe.js --run-local --write-matrix",
    "build:preview": "node scripts/build-preview.js"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
